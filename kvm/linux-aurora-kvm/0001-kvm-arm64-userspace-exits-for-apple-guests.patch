+/* The value userspace published for the read `imm`, in *val; false if it published none. */
+static bool apple_get_read(struct kvm_arm_apple_fast *f, u16 imm, u64 *val)
+{
+	u32 i, n = min_t(u32, f->nreads, ARRAY_SIZE(f->read_imm));
+
+	for (i = 0; i < n; i++) {
+		if (f->read_imm[i] == imm) {
+			*val = f->read_value[i];
+			return true;
+		}
+	}
+	return false;
+}
