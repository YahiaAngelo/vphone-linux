diff --git i/arch/arm64/include/uapi/asm/kvm.h w/arch/arm64/include/uapi/asm/kvm.h
index 1c13bfa2d..5f5c27d5f 100644
--- i/arch/arm64/include/uapi/asm/kvm.h
+++ w/arch/arm64/include/uapi/asm/kvm.h
@@ -158,6 +158,185 @@ struct kvm_sync_regs {
 	__u64 device_irq_level;
 };
 
+/*
+ * Apple guests (KVM_CAP_ARM_IMPDEF_SYSREG_TO_USER): the exception entries and returns
+ * userspace patched into IMPDEF traps, taken in the kernel when it publishes the PAC key
+ * sets here, at KVM_ARM_APPLE_FAST_OFFSET in run->s.padding (past device_irq_level).
+ */
+#define KVM_ARM_APPLE_FAST_OFFSET	64
+/*
+ * The layout's version: KVM_CHECK_EXTENSION(KVM_CAP_ARM_APPLE_FAST) returns it, and the magic
+ * carries it, so a userspace built for another layout is refused (the kernel ignores the area).
+ * Bump both with every change to struct kvm_arm_apple_fast.
+ */
+#define KVM_ARM_APPLE_FAST_VERSION	2
+#define KVM_ARM_APPLE_FAST_MAGIC	0x3230545341464150ULL	/* "PAFAST02" */
+struct kvm_arm_apple_fast {
+	__u64 magic;		/* userspace: MAGIC to enable, anything else disables */
+	__u64 pstate_mask;	/* userspace: the PSTATE bits an eret takes from SPSR_EL1 */
+	__u64 keys[2][10];	/* userspace: APIAKEYLO_EL1..APGAKEYHI_EL1 at EL0 and above */
+	__u64 sctlr[2];		/* userspace: SCTLR_EL1 at EL0 and above */
+	__u64 pac_el;		/* both: the set the vCPU holds, 0 or 1; 2: neither */
+	__u64 handled;		/* kernel: traps it took */
+	/* The return from userspace's TLB flush stub (KVM_ARM_APPLE_FAST_RESUME). */
+	__u64 resume_valid;	/* userspace: 1 while a flush is pending; kernel: 0 once resumed */
+	__u64 resume_pc;
+	__u64 resume_pstate;
+	__u64 resume_sctlr;	/* SCTLR_EL1 the vCPU resumes with, after the key set's */
+	__u64 resume_el;	/* the key set it resumes with, 0 or 1 */
+	/* Reads userspace answers from its own state: imm without Rt, and the value. */
+	__u32 nreads;
+	__u32 pad;
+	__u16 read_imm[16];
+	__u64 read_value[16];
+	/*
+	 * EL0 reads of a register EL0 can't reach on this CPU (an UNDEF that enters the guest's
+	 * lower-EL synchronous vector), at instruction addresses userspace saw before: answered
+	 * from read_imm/read_value and returned to EL0 at the next instruction.
+	 */
+	__u64 el0_ok;		/* userspace: 1 when such reads may be answered */
+	__u32 nsites;
+	__u32 pad2;
+	__u64 site_va[32];	/* the instruction's EL0 address */
+	__u16 site_imm[32];	/* read_imm of the register it reads */
+	__u8 site_rt[32];
+	__u64 disable;		/* userspace: traps to leave to it, 1 << (imm - 0x1340); bit 4 resume, 5 reads, 6 M1 bank, 7 world switches, 8 APCTL, 9 ASPSR writes, 10 key writes, 11 SPRR writes, 12 TTBR0 writes, 13 EL0 perm writes */
+	/*
+	 * An M1-style monitor's own exception registers (userspace's vregs 42-48 but 45: TPIDR,
+	 * VBAR, SPSR, ESR, ELR and FAR "_GL1") while it runs guarded: the vCPU's EL1 registers.
+	 */
+	__u64 guarded;		/* userspace: 1 while the guarded world runs, 0 otherwise */
+	__u64 m1_bank_ok;	/* userspace: 1 to take those accesses here */
+	/*
+	 * EL0 reads at addresses no site names: the instruction at ELR_EL1, read through the
+	 * vCPU's own stage-1 tables, whose encoding without Rt is el0_insn[i], is a read of
+	 * el0_insn_imm[i] (read_imm/read_value).
+	 */
+	__u32 n_el0_insn;
+	__u32 pad3;
+	__u32 el0_insn[4];
+	__u16 el0_insn_imm[4];
+	/*
+	 * World switches (genter 0x1420-0x143f, gexit 0x1400-0x141f) between the unguarded world
+	 * and the guarded one, as userspace's fast paths do them, where it publishes both worlds'
+	 * translation tables. bank[] is the world that doesn't run: SP_EL1, TPIDR_EL1, VBAR_EL1,
+	 * SPSR_EL1, ELR_EL1, ESR_EL1, FAR_EL1, which a switch exchanges with the vCPU's.
+	 */
+	__u64 ws_ok;		/* userspace: 1 genter, 2 gexit here; 4 flush every CPU's TLB; 8 the stub flushes */
+	__u64 bank[7];		/* both */
+	__u64 ttbr[2][2];	/* userspace: TTBR0/1_EL1 of the unguarded [0] and guarded [1] world */
+	__u64 enter_pc;		/* userspace: where genter enters the guarded world */
+	__u64 genter_pstate;	/* userspace: its PSTATE, but the caller's PAN, which it takes */
+	__u64 genter_esr;	/* userspace: its ESR_EL1, but the immediate's low five bits */
+	__u64 aspsr;		/* both: ASPSR_GL1, whose bit 0 leaves gexit to userspace */
+	__u64 status_other;	/* userspace: GXF_STATUS_EL1 but bit 0 (guarded) */
+	__u64 switches;		/* kernel: world switches it made */
+	__u64 stub_pc;		/* userspace: its TLB flush stub, for ws_ok bit 8 (flush there, as it does) */
+	/*
+	 * APCTL_EL1 (S3_4_C15_C0_4) at EL1, whose KernKeyEn (bit 2) adds the kernel key to the
+	 * keys above EL0: a change of other bits (AppleMode) goes to userspace. And ASPSR_GL1
+	 * writes while guarded, into aspsr, where ws_ok published it.
+	 */
+	__u64 apctl_ok;		/* userspace: 1 to take APCTL accesses here */
+	__u64 apctl;		/* both */
+	__u64 kernkey[2];	/* userspace: the kernel key, lo and hi */
+	/*
+	 * The vCPU's registers at an exit to userspace, which it reads here instead of one
+	 * KVM_GET_ONE_REG each. snap_reg[]: PC, PSTATE, SP_EL0, SP_EL1, TPIDR_EL1, VBAR_EL1,
+	 * SPSR_EL1, ELR_EL1, ESR_EL1, FAR_EL1, SCTLR_EL1, TCR_EL1, TTBR0_EL1, TTBR1_EL1.
+	 */
+	__u64 snap_ok;		/* userspace: 1 to have them */
+	__u64 snap_valid;	/* kernel: 1 at the exit; userspace clears it before it runs the vCPU */
+	__u64 snap_x[31];
+	__u64 snap_reg[14];
+	__u64 snap_insn;	/* kernel: at a data abort exit (KVM_EXIT_ARM_FAULT), the instruction at PC | 1 << 32 */
+	/*
+	 * Writes of the PAC keys (userspace's vregs 22-31, APIAKEYLO_EL1..APGAKEYHI_EL1) into
+	 * keys[0] (masked with the machine key in APCTL's AppleMode) and keys[1] (with the kernel
+	 * key under KernKeyEn); and SPRR permission writes (vregs 5, 6, 8) of the value a read
+	 * would give (read_imm/read_value), which change nothing.
+	 */
+	__u64 keys_ok;		/* userspace: 1 to take the key writes here */
+	__u64 mkey[2];		/* userspace: the machine key, lo and hi */
+	/*
+	 * Stores to write-protected leaf (level 3) guest page tables, taken here: the store (cas or
+	 * str of 64 bits at EL1) and each shadow copy's entry, from the table userspace publishes at
+	 * pt_table (struct kvm_arm_apple_pt_header, then pt_nslots struct kvm_arm_apple_pt_slot).
+	 */
+	__u64 pt_ok;		/* userspace: 1 to take them here */
+	__u64 pt_table;		/* userspace: the table's IPA */
+	__u64 pt_nslots;	/* userspace: a power of two */
+	__u64 pt_op;		/* kernel: 1 while it stores; userspace reuses a shadow page once all are 0 */
+	__u64 pt_handled;	/* kernel: stores it took */
+	__u64 pt_resync;	/* kernel: at exit KVM_ARM_APPLE_PT_RESYNC, the entry's IPA to resync */
+	__u64 pt_icache_pc[8];	/* kernel: the instructions it decoded, by address */
+	__u32 pt_icache_insn[8];
+	__u32 pt_icache_next;
+	__u32 pad4;
+	__u32 pt_why[16];	/* kernel: stores it left to userspace, by reason (kvm_arm_apple_pt_store) */
+	/*
+	 * TTBR0_EL1 writes (userspace's vreg 17) to a table userspace holds shadows of for both
+	 * worlds: ttbr0_base[i] is the guest table's address (TTBR0 bits 47:1), ttbr0_shadow[w][i]
+	 * the shadow's for the unguarded [0] and guarded [1] world. The vCPU's TTBR0_EL1 becomes
+	 * the written value's other bits (its ASID) with the running world's shadow, and ttbr[][0]
+	 * both worlds', for a world switch here.
+	 */
+	__u64 ttbr0_ok;		/* userspace: 1 to take them here; kernel: 0 after a perm write below */
+	__u32 nttbr0;		/* userspace: entries, at most 6 */
+	__u32 pad5;
+	__u64 ttbr0_base[6];
+	__u64 ttbr0_shadow[2][6];
+	__u64 ttbr0_guest;	/* kernel: the guest's TTBR0_EL1 after the last one */
+	__u64 ttbr0_writes;	/* kernel: those it took */
+	/*
+	 * EL0 writes of SPRR_UPERM_BR0_EL0 (userspace's vreg 5: an UNDEF into the lower-EL vector,
+	 * decoded as el0_insn), the JIT's write-protect toggles: the value becomes the current one
+	 * (read_imm/read_value) with the bits perm_mask lets EL0 change taken from the write. An
+	 * unchanged value returns to EL0; a changed one to an entry perm_val[i] whose TTBR0 table is
+	 * the current one (perm_ttbr0[i]; TTBR1's must be perm_ttbr1's) switches both worlds' tables
+	 * to perm_shadow[i][world][TTBR0, TTBR1] and enters the unguarded world at EL0 past the write,
+	 * as a world switch does it (its TLB flush). perm_mirror, if not 0, is the IPA of the guest's
+	 * own copy of the value for this CPU (8 bytes), written too.
+	 */
+	__u32 perm_ok;		/* userspace: 1 to take them here */
+	__u32 nperm;		/* userspace: entries, at most 2 */
+	__u64 perm_mask;
+	__u64 perm_ttbr1;
+	__u64 perm_mirror;
+	__u64 perm_val[2];
+	__u64 perm_ttbr0[2];
+	__u64 perm_shadow[2][2][2];
+	__u64 perm_guest;	/* kernel: the value after the last changing one */
+	__u64 perm_writes;	/* kernel: changing ones it took */
+};
+
+/* The table of struct kvm_arm_apple_fast's pt_table. */
+#define KVM_ARM_APPLE_PT_MAGIC		0x3154504154534146ULL	/* "FASTPAT1" */
+#define KVM_ARM_APPLE_PT_SLOTS_OFFSET	65536
+#define KVM_ARM_APPLE_PT_KEY_VALID	1ULL	/* key: the guest table page's IPA | 1 */
+#define KVM_ARM_APPLE_PT_KEY_TOMB	2ULL	/* a removed slot, which a lookup probes past */
+#define KVM_ARM_APPLE_PT_RESYNC		0x13f0	/* KVM_EXIT_HYPERCALL nr: resync pt_resync's shadows */
+struct kvm_arm_apple_pt_header {
+	__u64 magic;
+	__u32 nperms;
+	__u32 pad;
+	__u64 perms[32][16];	/* each set's permission bits by (AP_RO, AP_EL0, UXN, PXN); ~0: no access */
+};
+struct kvm_arm_apple_pt_slot {
+	__u32 seq;		/* odd while userspace writes the slot */
+	__u32 n;		/* mirrors: the shadow copies of the page */
+	__u64 key;
+	__u64 shadow[8];	/* each copy's shadow page IPA, 0 if it has none yet */
+	__u8 perm[8];		/* each copy's permission set */
+	__u8 pad[40];
+};
+/* The traps' 16-bit immediates (userspace's encoding: read 1, op1 3, crm 4, op2 3, rt 5). */
+#define KVM_ARM_APPLE_FAST_ENTRY	0x1340	/* exception entry from a lower EL */
+#define KVM_ARM_APPLE_FAST_ERET		0x1341
+#define KVM_ARM_APPLE_FAST_IRQ_ENTRY	0x1342
+#define KVM_ARM_APPLE_FAST_IRQ_LOWER	0x1343
+#define KVM_ARM_APPLE_FAST_RESUME	0x1300
+
 /* Bits for run->s.regs.device_irq_level */
 #define KVM_ARM_DEV_EL1_VTIMER		(1 << 0)
 #define KVM_ARM_DEV_EL1_PTIMER		(1 << 1)
@@ -208,6 +387,19 @@ struct kvm_arm_counter_offset {
 	__u64 reserved;
 };
 
+/*
+ * Guest physical range to write-protect, or to stop write-protecting.
+ * To be used with KVM_ARM_SET_WRITE_PROTECT.
+ */
+#define KVM_ARM_WRITE_PROTECT_ENABLE	(1U << 0)
+
+struct kvm_arm_write_protect {
+	__u64 gpa;
+	__u64 size;
+	__u32 flags;
+	__u32 reserved[3];
+};
+
 #define KVM_ARM_TAGS_TO_GUEST		0
 #define KVM_ARM_TAGS_FROM_GUEST		1
 
