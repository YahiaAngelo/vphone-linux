+/* Install the PAC key set and SCTLR_EL1 an Apple guest's EL @el runs with. */
+static void apple_fast_install(struct kvm_vcpu *vcpu, struct kvm_arm_apple_fast *f, int el)
+{
+	int k;
+
+	if (f->pac_el == el)
+		return;
+	for (k = 0; k < 10; k++)
+		vcpu_write_sys_reg(vcpu, f->keys[el][k], APIAKEYLO_EL1 + k);
+	vcpu_write_sys_reg(vcpu, f->sctlr[el], SCTLR_EL1);
+	f->pac_el = el;
+}
+
+/* SP_EL1 lives in the CPU while the vCPU is loaded (VHE saves it at vcpu_put). */
+static u64 apple_sp_el1(struct kvm_vcpu *vcpu, bool write, u64 val)
+{
+	u64 old;
+
+	preempt_disable();
+	if (vcpu_get_flag(vcpu, SYSREGS_ON_CPU)) {
+		old = read_sysreg(sp_el1);
+		if (write)
+			write_sysreg(val, sp_el1);
+	} else {
+		old = __vcpu_sys_reg(vcpu, SP_EL1);
+		if (write)
+			__vcpu_assign_sys_reg(vcpu, SP_EL1, val);
+	}
+	preempt_enable();
+	return old;
+}
+
+static const int apple_bank_regs[7] = {
+	-1, TPIDR_EL1, VBAR_EL1, SPSR_EL1, ELR_EL1, ESR_EL1, FAR_EL1,
+};
+
+/* Exchange the vCPU's banked EL1 registers with the world that doesn't run. */
+static void apple_swap_bank(struct kvm_vcpu *vcpu, struct kvm_arm_apple_fast *f)
+{
+	int i;
+
+	f->bank[0] = apple_sp_el1(vcpu, true, f->bank[0]);
+	for (i = 1; i < 7; i++) {
+		u64 cur = vcpu_read_sys_reg(vcpu, apple_bank_regs[i]);
+
+		vcpu_write_sys_reg(vcpu, f->bank[i], apple_bank_regs[i]);
+		f->bank[i] = cur;
+	}
+}
+
+/* The published value of the read `imm` (without Rt), where userspace answers it here. */
+static void apple_set_read(struct kvm_arm_apple_fast *f, u16 imm, u64 val)
+{
+	u32 i, n = min_t(u32, f->nreads, ARRAY_SIZE(f->read_imm));
+
+	for (i = 0; i < n; i++)
+		if (f->read_imm[i] == imm)
+			f->read_value[i] = val;
+}
+
+/*
+ * Enter world `guarded` at `pc` with `pstate`: its tables, the key set and SCTLR of its EL, and a
+ * flush of this CPU's TLB for the VM (the worlds' tables differ under one VMID), with every other
+ * CPU made to flush before this VM runs there again.
+ */
+static void apple_enter_world(struct kvm_vcpu *vcpu, struct kvm_arm_apple_fast *f, int guarded,
+			      u64 pstate, u64 pc)
+{
+	struct kvm_s2_mmu *mmu = vcpu->arch.hw_mmu;
+	int cpu;
+
+	vcpu_write_sys_reg(vcpu, f->ttbr[guarded][0], TTBR0_EL1);
+	vcpu_write_sys_reg(vcpu, f->ttbr[guarded][1], TTBR1_EL1);
+	apple_fast_install(vcpu, f, (pstate >> 2) & 3);
+	*vcpu_cpsr(vcpu) = pstate;
+	*vcpu_pc(vcpu) = pc;
+	f->guarded = guarded;
+	apple_set_read(f, 0x8000 | (2 << 6) | 0x20, f->status_other | guarded);	/* GXF_STATUS */
+	apple_set_read(f, 0x8000 | (45 << 6) | 0x20, f->aspsr);		/* ASPSR_GL1 */
+	if (f->ws_ok & 4) {
+		/* Every CPU's TLB for the VM. */
+		kvm_call_hyp(__kvm_tlb_flush_vmid, mmu);
+	} else {
+		preempt_disable();
+		kvm_call_hyp(__kvm_flush_cpu_context, mmu);
+		for_each_possible_cpu(cpu)
+			if (cpu != smp_processor_id())
+				*per_cpu_ptr(mmu->last_vcpu_ran, cpu) = -1;
+		preempt_enable();
+	}
+	f->switches++;
+}
+
+/* genter (from EL1 of the unguarded world) and gexit, where userspace published both worlds. */
+static int apple_fast_world(struct kvm_vcpu *vcpu, struct kvm_arm_apple_fast *f, u16 imm)
+{
+	u64 cpsr = *vcpu_cpsr(vcpu);
+
+	if (!(f->ws_ok & 3) || f->resume_valid)
+		return 0;
+	if ((imm & 0xffe0) == 0x1420 && (f->ws_ok & 1)) {
+		u64 ret = *vcpu_pc(vcpu) + 4;
+
+		if (f->guarded != 0 || ((cpsr >> 2) & 3) != 1 || (cpsr & PSR_MODE32_BIT))
+			return 0;
+		apple_swap_bank(vcpu, f);
+		/* Now the guarded world's registers: the caller's return state and syndrome. */
+		vcpu_write_sys_reg(vcpu, cpsr, SPSR_EL1);
+		vcpu_write_sys_reg(vcpu, ret, ELR_EL1);
+		vcpu_write_sys_reg(vcpu, f->genter_esr | (imm & 0x1f), ESR_EL1);
+		f->aspsr &= ~1ULL;
+		apple_enter_world(vcpu, f, 1, f->genter_pstate | (cpsr & PSR_PAN_BIT), f->enter_pc);
+		f->handled++;
+		return 1;
+	}
+	if ((imm & 0xffe0) == 0x1400 && (f->ws_ok & 2)) {
+		u64 spsr, elr;
+
+		if (f->guarded != 1 || (f->aspsr & 1))
+			return 0;
+		apple_swap_bank(vcpu, f);
+		/* bank[] now holds the guarded world's: return to its ELR with its SPSR. */
+		spsr = f->bank[3] & f->pstate_mask;
+		elr = f->bank[4];
+		if (((spsr >> 2) & 3) > 1) {
+			apple_swap_bank(vcpu, f);
+			return 0;
+		}
+		apple_enter_world(vcpu, f, 0, spsr, elr);
+		f->handled++;
+		return 1;
+	}
+	return 0;
+}
+
+/*
+ * An UNDEF from EL0 that entered the guest's lower-EL synchronous vector: a read at an address
+ * userspace published, answered here and returned to EL0 past it. 0 for userspace.
+ */
+static int apple_fast_el0_read(struct kvm_vcpu *vcpu, struct kvm_arm_apple_fast *f)
+{
+	u64 spsr = vcpu_read_sys_reg(vcpu, SPSR_EL1);
+	u64 elr = vcpu_read_sys_reg(vcpu, ELR_EL1);
+	u32 i, j, n = min_t(u32, READ_ONCE(f->nsites), ARRAY_SIZE(f->site_va));
+	u32 nr = min_t(u32, READ_ONCE(f->nreads), ARRAY_SIZE(f->read_imm));
+
+	if (f->el0_ok != 1 || (spsr & (PSR_MODE32_BIT | PSR_MODE_MASK)) != PSR_MODE_EL0t ||
+	    *vcpu_pc(vcpu) - vcpu_read_sys_reg(vcpu, VBAR_EL1) != 0x400)
+		return 0;
+	u16 imm = 0;
+	u8 rt = 31;
+
+	for (i = 0; i < n; i++) {
+		if (f->site_va[i] == elr) {
+			imm = f->site_imm[i];
+			rt = f->site_rt[i];
+			break;
+		}
+	}
+	/* No site: the instruction itself, through the vCPU's stage-1 tables. */
+	if (!imm && READ_ONCE(f->n_el0_insn)) {
+		struct s1_walk_info wi = { .regime = TR_EL10, .as_el0 = true };
+		struct s1_walk_result wr = {};
+		u32 insn, k, ni = min_t(u32, f->n_el0_insn, ARRAY_SIZE(f->el0_insn));
+
+		if (__kvm_translate_va(vcpu, &wi, &wr, elr) || wr.failed || !wr.ux ||
+		    kvm_read_guest(vcpu->kvm, wr.pa, &insn, sizeof(insn)))
+			return 0;
+		insn = le32_to_cpu(insn);
+		for (k = 0; k < ni; k++) {
+			if ((insn & ~0x1fU) == f->el0_insn[k]) {
+				imm = f->el0_insn_imm[k];
+				rt = insn & 0x1f;
+				break;
+			}
+		}
+	}
+	if (!imm)
+		return 0;
+	for (j = 0; j < nr; j++) {
+		if (f->read_imm[j] != imm)
+			continue;
+		if (rt != 31)
+			vcpu_set_reg(vcpu, rt, f->read_value[j]);
+		*vcpu_cpsr(vcpu) = spsr & f->pstate_mask;
+		*vcpu_pc(vcpu) = elr + 4;
+		apple_fast_install(vcpu, f, 0);
+		f->handled++;
+		return 1;
+	}
+	return 0;
+}
+
+/*
+ * An Apple guest's patched exception entry, exception return or IRQ entry, where userspace
+ * published its PAC key sets: done here, as userspace's fast path does it, without an exit.
+ * Returns 1 if handled, 0 to go to userspace.
+ */
+static int apple_fast_trap(struct kvm_vcpu *vcpu, unsigned long esr)
+{
+	struct kvm_arm_apple_fast *f =
+		(void *)vcpu->run->s.padding + KVM_ARM_APPLE_FAST_OFFSET;
+	struct sys_reg_params p = esr_sys64_to_params(esr);
+	u16 imm;
+	u64 spsr;
+	int el;
+
+	if (READ_ONCE(f->magic) != KVM_ARM_APPLE_FAST_MAGIC || p.CRn != 11 || f->pac_el > 2)
+		return 0;
+	imm = (!p.is_write << 15) | (p.Op1 << 12) | (p.CRm << 8) | (p.Op2 << 5) |
+	      kvm_vcpu_sys_get_rt(vcpu);
+	/* A guarded monitor's own exception register, live in the vCPU's EL1 registers. */
+	if ((imm & 0x8000) && f->m1_bank_ok == 1 && f->guarded == 1 && !(f->disable & BIT(6))) {
+		int reg = -1, rt = imm & 0x1f;
+
+		switch ((imm >> 6) & 0x1ff) {
+		case 42: reg = TPIDR_EL1; break;
+		case 43: reg = VBAR_EL1; break;
+		case 44: reg = SPSR_EL1; break;
+		case 46: reg = ESR_EL1; break;
+		case 47: reg = ELR_EL1; break;
+		case 48: reg = FAR_EL1; break;
+		}
+		if (reg >= 0) {
+			if (imm & 0x20) {
+				if (rt != 31)
+					vcpu_set_reg(vcpu, rt, vcpu_read_sys_reg(vcpu, reg));
+			} else {
+				vcpu_write_sys_reg(vcpu, rt == 31 ? 0 : vcpu_get_reg(vcpu, rt), reg);
+			}
+			kvm_incr_pc(vcpu);
+			f->handled++;
+			return 1;
+		}
+	}
+	/* A register read userspace answers from its own state. */
+	if ((imm & 0x8020) == 0x8020) {
+		if (f->disable & BIT(5))
+			return 0;
+		u32 i, n = min_t(u32, READ_ONCE(f->nreads), ARRAY_SIZE(f->read_imm));
+		int rt = imm & 0x1f;
+
+		for (i = 0; i < n; i++) {
+			if (f->read_imm[i] != (imm & ~0x1f))
+				continue;
+			if (rt != 31)
+				vcpu_set_reg(vcpu, rt, f->read_value[i]);
+			kvm_incr_pc(vcpu);
+			f->handled++;
+			return 1;
+		}
+		return 0;
+	}
+	if (imm >= 0x1340 && imm <= 0x1343 && (f->disable & BIT(imm - 0x1340)))
+		return 0;
+	if ((imm & 0xffc0) == 0x1400 && !(f->disable & BIT(7)))
+		return apple_fast_world(vcpu, f, imm);
+	if (imm == KVM_ARM_APPLE_FAST_RESUME && (f->disable & BIT(4)))
+		return 0;
+	switch (imm) {
+	case KVM_ARM_APPLE_FAST_ENTRY:
+		/* An EL0 SPRR access (an UNDEF): a known read here, the rest in userspace. */
+		if (ESR_ELx_EC(vcpu_read_sys_reg(vcpu, ESR_EL1)) == ESR_ELx_EC_UNKNOWN)
+			return apple_fast_el0_read(vcpu, f);
+		fallthrough;
+	case KVM_ARM_APPLE_FAST_IRQ_LOWER:
+		apple_fast_install(vcpu, f, 1);
+		fallthrough;
+	case KVM_ARM_APPLE_FAST_IRQ_ENTRY:
+		kvm_incr_pc(vcpu);
+		break;
+	case KVM_ARM_APPLE_FAST_RESUME:
+		if (f->resume_valid != 1 || f->resume_el > 1)
+			return 0;
+		f->pac_el = 2;
+		apple_fast_install(vcpu, f, f->resume_el);
+		vcpu_write_sys_reg(vcpu, f->resume_sctlr, SCTLR_EL1);
+		*vcpu_cpsr(vcpu) = f->resume_pstate;
+		*vcpu_pc(vcpu) = f->resume_pc;
+		f->resume_valid = 0;
+		break;
+	case KVM_ARM_APPLE_FAST_ERET:
+		spsr = vcpu_read_sys_reg(vcpu, SPSR_EL1);
+		el = (spsr >> 2) & 3;
+		if (el > 1)
+			return 0;
+		*vcpu_cpsr(vcpu) = spsr & f->pstate_mask;
+		*vcpu_pc(vcpu) = vcpu_read_sys_reg(vcpu, ELR_EL1);
+		apple_fast_install(vcpu, f, el);
+		break;
+	default:
+		return 0;
+	}
+	f->handled++;
+	return 1;
+}
