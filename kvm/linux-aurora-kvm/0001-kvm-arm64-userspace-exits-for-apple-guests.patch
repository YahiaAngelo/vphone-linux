+		}
+	}
+	/* No site: the instruction itself, through the vCPU's stage-1 tables. */
+	if (!imm && READ_ONCE(f->n_el0_insn)) {
+		struct s1_walk_info wi = { .regime = TR_EL10, .as_el0 = true };
+		struct s1_walk_result wr = {};
+		u32 insn, k, ni = min_t(u32, f->n_el0_insn, ARRAY_SIZE(f->el0_insn));
+
+		if (__kvm_translate_va(vcpu, &wi, &wr, elr) || wr.failed || !wr.ux ||
+		    kvm_read_guest(vcpu->kvm, wr.pa, &insn, sizeof(insn)))
+			return 0;
+		insn = le32_to_cpu(insn);
+		f->pt_why[15]++;	/* debug: stage-1 decodes */
+		for (k = 0; k < ni; k++) {
+			if ((insn & ~0x1fU) == f->el0_insn[k]) {
+				imm = f->el0_insn_imm[k];
+				rt = insn & 0x1f;
+				vcpu->arch.apple_el0_va[c] = elr;
+				vcpu->arch.apple_el0_ttbr[c] = ttbr;
+				vcpu->arch.apple_el0_imm[c] = imm;
+				vcpu->arch.apple_el0_rt[c] = rt;
+				break;
+			}
+		}
+	}
+	if (!imm)
+		return 0;
+	/* A write (bit 5 clear) of SPRR_UPERM_BR0_EL0. */
+	if (!(imm & 0x20) && ((imm >> 6) & 0x1ff) == 5)
+		return apple_fast_el0_perm_write(vcpu, f, rt, spsr, elr);
+	for (j = 0; j < nr; j++) {
+		if (f->read_imm[j] != imm)
+			continue;
+		if (rt != 31)
+			vcpu_set_reg(vcpu, rt, f->read_value[j]);
+		*vcpu_cpsr(vcpu) = spsr & f->pstate_mask;
+		*vcpu_pc(vcpu) = elr + 4;
+		apple_fast_install(vcpu, f, 0);
+		f->handled++;
+		return 1;
+	}
+	return 0;
+}
+
+/*
+ * An Apple guest's patched exception entry, exception return or IRQ entry, where userspace
+ * published its PAC key sets: done here, as userspace's fast path does it, without an exit.
+ * Returns 1 if handled, 0 to go to userspace.
+ */
+/* The vCPU's registers for userspace at an exit to it (struct kvm_arm_apple_fast's snap_*). */
+void kvm_arm_apple_snapshot(struct kvm_vcpu *vcpu)
+{
+	static const int sys[] = { SP_EL1, TPIDR_EL1, VBAR_EL1, SPSR_EL1, ELR_EL1, ESR_EL1,
+				   FAR_EL1, SCTLR_EL1, TCR_EL1, TTBR0_EL1, TTBR1_EL1 };
+	struct kvm_arm_apple_fast *f =
+		(void *)vcpu->run->s.padding + KVM_ARM_APPLE_FAST_OFFSET;
+	int i;
+
+	if (READ_ONCE(f->magic) != KVM_ARM_APPLE_FAST_MAGIC || f->snap_ok != 1)
+		return;
+	for (i = 0; i < 31; i++)
+		f->snap_x[i] = vcpu_get_reg(vcpu, i);
+	f->snap_reg[0] = *vcpu_pc(vcpu);
+	f->snap_reg[1] = *vcpu_cpsr(vcpu);
+	f->snap_reg[2] = vcpu_gp_regs(vcpu)->sp;
+	for (i = 0; i < ARRAY_SIZE(sys); i++)
+		f->snap_reg[3 + i] = vcpu_read_sys_reg(vcpu, sys[i]);
+	f->snap_insn = 0;
+	if (vcpu->run->exit_reason == KVM_EXIT_ARM_FAULT &&
+	    ESR_ELx_EC(vcpu->run->arm_fault.esr) == ESR_ELx_EC_DABT_LOW) {
+		struct s1_walk_info wi = {
+			.regime = TR_EL10,
+			.as_el0 = ((f->snap_reg[1] >> 2) & 3) == 0,
+		};
+		struct s1_walk_result wr = {};
+		u32 insn;
+
+		if (!__kvm_translate_va(vcpu, &wi, &wr, f->snap_reg[0]) && !wr.failed &&
+		    !kvm_read_guest(vcpu->kvm, wr.pa, &insn, sizeof(insn)))
+			f->snap_insn = le32_to_cpu(insn) | BIT_ULL(32);
+	}
+	f->snap_valid = 1;
+}
+
+/* A leaf guest descriptor as a shadow copy has it: its permission bits from the copy's set. */
+static u64 apple_pt_shadow_desc(const u64 *leaf, u64 d)
+{
+	const u64 bits = BIT_ULL(7) | BIT_ULL(6) | BIT_ULL(54) | BIT_ULL(53);
+	u32 index;
+
+	/* Invalid, or a level 3 descriptor without the table bit (reserved). */
+	if ((d & 3) != 3)
+		return 0;
+	index = (d & BIT_ULL(7) ? 8 : 0) | (d & BIT_ULL(6) ? 4 : 0) | (d & BIT_ULL(54) ? 2 : 0) |
+		(d & BIT_ULL(53) ? 1 : 0);
+	if (leaf[index] == ~0ULL)
+		return 0;
+	return (d & ~bits) | leaf[index];
+}
+
+/* The instruction at EL1 address pc, from the vCPU's stage-1 tables, cached by address. */
+static bool apple_pt_insn(struct kvm_vcpu *vcpu, struct kvm_arm_apple_fast *f, u64 pc, u32 *insn)
+{
+	struct s1_walk_info wi = { .regime = TR_EL10 };
+	struct s1_walk_result wr = {};
+	u32 i, v;
+
+	for (i = 0; i < ARRAY_SIZE(f->pt_icache_pc); i++) {
+		if (f->pt_icache_pc[i] == pc) {
+			*insn = f->pt_icache_insn[i];
+			return true;
+		}
+	}
+	if (__kvm_translate_va(vcpu, &wi, &wr, pc) || wr.failed ||
+	    kvm_read_guest(vcpu->kvm, wr.pa, &v, sizeof(v)))
+		return false;
+	*insn = le32_to_cpu(v);
+	i = f->pt_icache_next++ % ARRAY_SIZE(f->pt_icache_pc);
+	f->pt_icache_pc[i] = pc;
+	f->pt_icache_insn[i] = *insn;
+	return true;
+}
+
+/* A store kvm_arm_apple_pt_store leaves to userspace, counted by why. */
+static int apple_pt_why(struct kvm_arm_apple_fast *f, int why)
+{
+	if (why < ARRAY_SIZE(f->pt_why))
+		f->pt_why[why]++;
+	return -1;
+}
+
+/*
+ * A store at EL1 to a write-protected guest page table at ipa, taken here when the table is a leaf
+ * table userspace published (struct kvm_arm_apple_fast pt_*): the store, then each shadow copy's
+ * entry. 1: done, the guest resumes; 0: done, but userspace resyncs the entry
+ * (KVM_ARM_APPLE_PT_RESYNC); -1: userspace takes the fault as before.
+ */
+int kvm_arm_apple_pt_store(struct kvm_vcpu *vcpu, phys_addr_t ipa, u64 far, u64 esr)
+{
+	struct kvm_arm_apple_fast *f =
+		(void *)vcpu->run->s.padding + KVM_ARM_APPLE_FAST_OFFSET;
+	struct kvm_arm_apple_pt_slot slot;
+	struct kvm_host_map map;
+	u64 cpsr = *vcpu_cpsr(vcpu), page = ipa & PAGE_MASK, leaf[8][16];
+	u64 pc = *vcpu_pc(vcpu), base, va, cmp = 0, val, cur, sh, h, slots;
+	u32 insn, rn, rt, rs = 31, seq, i, k, probe;
+	bool cas, ok = true, resync = false, shadow_w;
+	unsigned long hva[8];
+	u64 *ptr;
+
+	if (READ_ONCE(f->magic) != KVM_ARM_APPLE_FAST_MAGIC || f->pt_ok != 1 || !f->pt_nslots ||
+	    (f->pt_nslots & (f->pt_nslots - 1)))
+		return apple_pt_why(f, 1);
+	if (vcpu->guest_debug)
+		return apple_pt_why(f, 13);
+	if (((cpsr >> 2) & 3) != 1)
+		return apple_pt_why(f, 14);
+	if (!apple_pt_insn(vcpu, f, pc, &insn))
+		return apple_pt_why(f, 2);
+	rn = (insn >> 5) & 31;
+	rt = insn & 31;
+	if ((insn & 0xffa07c00) == 0xc8a07c00) {		/* cas{,a,l,al} Xs, Xt, [Xn] */
+		cas = true;
+		rs = (insn >> 16) & 31;
+		va = 0;
+	} else if ((insn & 0xffc00000) == 0xf9000000) {		/* str Xt, [Xn, #imm] */
+		cas = false;
+		va = ((insn >> 10) & 0xfff) * 8;
+	} else {
+		return apple_pt_why(f, 3);
+	}
+	base = rn != 31 ? vcpu_get_reg(vcpu, rn) : (cpsr & 1) ? apple_sp_el1(vcpu, false, 0) :
+	       vcpu_gp_regs(vcpu)->sp;
+	va += base;
+	if ((va & 7) || (!(esr & ESR_ELx_FnV) && (far & ~PAGE_MASK) != (va & ~PAGE_MASK)))
+		return apple_pt_why(f, 4);
+	val = rt == 31 ? 0 : vcpu_get_reg(vcpu, rt);
+	if (cas)
+		cmp = rs == 31 ? 0 : vcpu_get_reg(vcpu, rs);
+
+	/* The page's slot: an even sequence number, the same before and after reading it. */
+	slots = f->pt_table + KVM_ARM_APPLE_PT_SLOTS_OFFSET;
+	h = ((page >> PAGE_SHIFT) * 0x9e3779b97f4a7c15ULL) >> (64 - ilog2(f->pt_nslots));
+	for (probe = 0; probe < 32; probe++, h = (h + 1) & (f->pt_nslots - 1)) {
+		if (kvm_read_guest(vcpu->kvm, slots + h * sizeof(slot), &slot, sizeof(slot)))
+			return apple_pt_why(f, 5);
+		if (slot.key == 0)
+			return apple_pt_why(f, 6);
+		if (slot.key == (page | KVM_ARM_APPLE_PT_KEY_VALID))
+			break;
+	}
+	if (probe == 32 || (slot.seq & 1) || slot.n == 0 || slot.n > ARRAY_SIZE(slot.shadow))
+		return apple_pt_why(f, 7);
+	for (k = 0; k < slot.n; k++) {
+		if (slot.perm[k] >= 32 ||
+		    kvm_read_guest(vcpu->kvm, f->pt_table + offsetof(struct kvm_arm_apple_pt_header, perms) +
+				   slot.perm[k] * sizeof(leaf[k]), leaf[k], sizeof(leaf[k])))
+			return apple_pt_why(f, 8);
+		/* A copy without a shadow page yet gets one from userspace, as the entry becomes valid. */
+		if (!slot.shadow[k] && apple_pt_shadow_desc(leaf[k], val))
+			return apple_pt_why(f, 9);
+		/* The shadows' memslot is read-only to the guest; the host's mapping of it is writable. */
+		hva[k] = slot.shadow[k] ? gfn_to_hva_prot(vcpu->kvm, slot.shadow[k] >> PAGE_SHIFT, &shadow_w) : 0;
+		if (slot.shadow[k] && kvm_is_error_hva(hva[k]))
+			return apple_pt_why(f, 10);
+	}
+	if (kvm_vcpu_map(vcpu, page >> PAGE_SHIFT, &map))
+		return apple_pt_why(f, 11);
+
+	/* Userspace reuses no shadow page while this runs, and the slot it published still stands. */
+	WRITE_ONCE(f->pt_op, 1);
+	smp_mb();
+	if (kvm_read_guest(vcpu->kvm, slots + h * sizeof(slot), &seq, sizeof(seq)) || seq != slot.seq) {
+		smp_mb();
+		WRITE_ONCE(f->pt_op, 0);
+		kvm_vcpu_unmap(vcpu, &map);
+		return apple_pt_why(f, 12);
+	}
+
+	ptr = (u64 *)((u8 *)map.hva + (va & ~PAGE_MASK));
+	if (cas) {
+		cur = cmpxchg64(ptr, cmp, val);
+		ok = cur == cmp;
+		if (rs != 31)
+			vcpu_set_reg(vcpu, rs, cur);
+	} else {
+		WRITE_ONCE(*ptr, val);
+	}
+	/* Each copy from the entry as it stands, again if another store changed it meanwhile. */
+	for (i = 0; ok && i < 4; i++) {
+		cur = READ_ONCE(*ptr);
+		for (k = 0; k < slot.n; k++) {
+			sh = apple_pt_shadow_desc(leaf[k], cur);
+			if (!hva[k]) {
+				resync |= sh != 0;
+				continue;
+			}
+			if (put_user(sh, (u64 __user *)(hva[k] + (va & ~PAGE_MASK))))
+				resync = true;
+		}
+		smp_mb();
+		if (READ_ONCE(*ptr) == cur)
+			break;
+	}
+	resync |= i == 4;
+	smp_mb();
+	WRITE_ONCE(f->pt_op, 0);
+	kvm_vcpu_unmap(vcpu, &map);
+
+	kvm_incr_pc(vcpu);
+	f->pt_handled++;
+	if (!resync)
+		return 1;
+	f->pt_resync = page | (va & ~PAGE_MASK);
+	vcpu->run->exit_reason = KVM_EXIT_HYPERCALL;
+	vcpu->run->hypercall = (typeof(vcpu->run->hypercall)) { .nr = KVM_ARM_APPLE_PT_RESYNC };
+	return 0;
+}
+
+/* APCTL_EL1 at EL1: MKEYVld (bit 1) is read-only, KernKeyEn (bit 2) changes the keys above EL0. */
+static int apple_fast_apctl(struct kvm_vcpu *vcpu, struct kvm_arm_apple_fast *f,
+			    struct sys_reg_params *p)
+{
+	int rt = kvm_vcpu_sys_get_rt(vcpu), k;
+	u64 val;
+
+	if (f->apctl_ok != 1 || (f->disable & BIT(8)) || f->pac_el > 1 ||
+	    ((*vcpu_cpsr(vcpu) >> 2) & 3) != 1)
+		return 0;
+	if (!p->is_write) {
+		if (rt != 31)
+			vcpu_set_reg(vcpu, rt, f->apctl);
+	} else {
+		val = rt == 31 ? 0 : vcpu_get_reg(vcpu, rt);
+		val = (val & ~BIT(1)) | (f->apctl & BIT(1));
+		if ((val ^ f->apctl) & ~BIT(2))
+			return 0;
+		if (val != f->apctl) {
+			for (k = 0; k < 10; k++)
+				f->keys[1][k] ^= f->kernkey[k & 1];
+			f->apctl = val;
+			if (f->pac_el == 1) {
+				f->pac_el = 2;
+				apple_fast_install(vcpu, f, 1);
+			}
+		}
+	}
+	kvm_incr_pc(vcpu);
+	f->handled++;
+	return 1;
+}
+
+static int apple_fast_trap(struct kvm_vcpu *vcpu, unsigned long esr)
+{
+	struct kvm_arm_apple_fast *f =
+		(void *)vcpu->run->s.padding + KVM_ARM_APPLE_FAST_OFFSET;
+	struct sys_reg_params p = esr_sys64_to_params(esr);
+	u16 imm;
+	u64 spsr;
+	int el;
+
+	if (READ_ONCE(f->magic) != KVM_ARM_APPLE_FAST_MAGIC || f->pac_el > 2)
+		return 0;
+	if (p.CRn == 15 && p.Op1 == 4 && p.CRm == 0 && p.Op2 == 4)
+		return apple_fast_apctl(vcpu, f, &p);
+	if (p.CRn != 11)
+		return 0;
+	imm = (!p.is_write << 15) | (p.Op1 << 12) | (p.CRm << 8) | (p.Op2 << 5) |
+	      kvm_vcpu_sys_get_rt(vcpu);
+	/* A guarded monitor's own exception register, live in the vCPU's EL1 registers. */
+	if ((imm & 0x8000) && f->m1_bank_ok == 1 && f->guarded == 1 && !(f->disable & BIT(6))) {
+		int reg = -1, rt = imm & 0x1f;
+
+		switch ((imm >> 6) & 0x1ff) {
+		case 42: reg = TPIDR_EL1; break;
+		case 43: reg = VBAR_EL1; break;
+		case 44: reg = SPSR_EL1; break;
+		case 46: reg = ESR_EL1; break;
+		case 47: reg = ELR_EL1; break;
+		case 48: reg = FAR_EL1; break;
+		}
+		if (reg >= 0) {
+			if (imm & 0x20) {
+				if (rt != 31)
+					vcpu_set_reg(vcpu, rt, vcpu_read_sys_reg(vcpu, reg));
+			} else {
+				vcpu_write_sys_reg(vcpu, rt == 31 ? 0 : vcpu_get_reg(vcpu, rt), reg);
+			}
+			kvm_incr_pc(vcpu);
+			f->handled++;
+			return 1;
+		}
+	}
+	/* A guarded monitor's ASPSR_GL1 write (vreg 45), where a world switch takes it from. */
+	if ((imm & 0xffe0) == 0x8b40 && f->ws_ok && f->guarded == 1 && !(f->disable & BIT(9))) {
+		int rt = imm & 0x1f;
+
+		f->aspsr = rt == 31 ? 0 : vcpu_get_reg(vcpu, rt);
+		apple_set_read(f, 0x8b60, f->aspsr);
+		kvm_incr_pc(vcpu);
+		f->handled++;
+		return 1;
+	}
+	/* A TTBR0_EL1 write (vreg 17) to a table userspace published the shadows of. */
+	if ((imm & 0x8020) == 0x8000 && ((imm >> 6) & 0x1ff) == 17 && f->ttbr0_ok == 1 &&
+	    !(f->disable & BIT(12))) {
+		int rt = imm & 0x1f, g = f->guarded == 1, i;
+		u64 v = rt == 31 ? 0 : vcpu_get_reg(vcpu, rt);
+		u64 base = v & 0x0000fffffffffffeULL, keep = v & ~0x0000ffffffffffffULL;
+		u32 n = min_t(u32, READ_ONCE(f->nttbr0), ARRAY_SIZE(f->ttbr0_base));
+
+		for (i = 0; i < n; i++) {
+			if (f->ttbr0_base[i] != base)
+				continue;
+			vcpu_write_sys_reg(vcpu, keep | f->ttbr0_shadow[g][i], TTBR0_EL1);
+			f->ttbr[g][0] = keep | f->ttbr0_shadow[g][i];
+			f->ttbr[!g][0] = keep | f->ttbr0_shadow[!g][i];
+			f->ttbr0_guest = v;
+			f->ttbr0_writes++;
+			/* A later read in this run answers the value written. */
+			apple_set_read(f, 0x8000 | (17 << 6) | 0x20, v);
+			kvm_incr_pc(vcpu);
+			f->handled++;
+			return 1;
+		}
+		return 0;
+	}
+	/* A PAC key write. */
+	if ((imm & 0x8020) == 0x8000 && ((imm >> 6) & 0x1ff) >= 22 && ((imm >> 6) & 0x1ff) <= 31 &&
+	    f->keys_ok == 1 && f->pac_el < 2 && !(f->disable & BIT(10))) {
+		int k = ((imm >> 6) & 0x1ff) - 22, rt = imm & 0x1f;
+		u64 v = rt == 31 ? 0 : vcpu_get_reg(vcpu, rt);
+
+		if (f->apctl & BIT(0))
+			v ^= f->mkey[k & 1];
+		f->keys[0][k] = v;
+		f->keys[1][k] = (f->apctl & BIT(2)) ? v ^ f->kernkey[k & 1] : v;
+		vcpu_write_sys_reg(vcpu, f->keys[f->pac_el][k], APIAKEYLO_EL1 + k);
+		kvm_incr_pc(vcpu);
+		f->handled++;
+		return 1;
+	}
+	/* An SPRR permission write of the value it already has. */
+	if ((imm & 0x8020) == 0x8000 && !(f->disable & BIT(11))) {
+		u32 vreg = (imm >> 6) & 0x1ff, i, n = min_t(u32, READ_ONCE(f->nreads), ARRAY_SIZE(f->read_imm));
+		int rt = imm & 0x1f;
+		u64 v = rt == 31 ? 0 : vcpu_get_reg(vcpu, rt);
+
+		if (vreg == 5 || vreg == 6 || vreg == 8) {
+			for (i = 0; i < n; i++) {
+				if (f->read_imm[i] == ((imm & ~0x1f) | 0x20) && f->read_value[i] == v) {
+					kvm_incr_pc(vcpu);
+					f->handled++;
+					return 1;
+				}
+			}
+		}
+	}
+	/* A register read userspace answers from its own state. */
+	if ((imm & 0x8020) == 0x8020) {
+		if (f->disable & BIT(5))
+			return 0;
+		u32 i, n = min_t(u32, READ_ONCE(f->nreads), ARRAY_SIZE(f->read_imm));
+		int rt = imm & 0x1f;
+
+		for (i = 0; i < n; i++) {
+			if (f->read_imm[i] != (imm & ~0x1f))
+				continue;
+			if (rt != 31)
+				vcpu_set_reg(vcpu, rt, f->read_value[i]);
+			kvm_incr_pc(vcpu);
+			f->handled++;
+			return 1;
+		}
+		return 0;
+	}
+	if (imm >= 0x1340 && imm <= 0x1343 && (f->disable & BIT(imm - 0x1340)))
+		return 0;
+	if ((imm & 0xffc0) == 0x1400 && !(f->disable & BIT(7)))
+		return apple_fast_world(vcpu, f, imm);
+	if (imm == KVM_ARM_APPLE_FAST_RESUME && (f->disable & BIT(4)))
+		return 0;
+	switch (imm) {
+	case KVM_ARM_APPLE_FAST_ENTRY:
+		/* An EL0 SPRR access (an UNDEF): a known read here, the rest in userspace. */
+		if (ESR_ELx_EC(vcpu_read_sys_reg(vcpu, ESR_EL1)) == ESR_ELx_EC_UNKNOWN)
+			return apple_fast_el0_read(vcpu, f);
+		fallthrough;
+	case KVM_ARM_APPLE_FAST_IRQ_LOWER:
+		apple_fast_install(vcpu, f, 1);
+		fallthrough;
+	case KVM_ARM_APPLE_FAST_IRQ_ENTRY:
+		kvm_incr_pc(vcpu);
+		break;
+	case KVM_ARM_APPLE_FAST_RESUME:
+		if (f->resume_valid != 1 || f->resume_el > 1)
+			return 0;
+		f->pac_el = 2;
+		apple_fast_install(vcpu, f, f->resume_el);
+		vcpu_write_sys_reg(vcpu, f->resume_sctlr, SCTLR_EL1);
+		*vcpu_cpsr(vcpu) = f->resume_pstate;
+		*vcpu_pc(vcpu) = f->resume_pc;
+		f->resume_valid = 0;
+		break;
+	case KVM_ARM_APPLE_FAST_ERET:
+		spsr = vcpu_read_sys_reg(vcpu, SPSR_EL1);
+		el = (spsr >> 2) & 3;
+		if (el > 1)
+			return 0;
+		*vcpu_cpsr(vcpu) = spsr & f->pstate_mask;
+		*vcpu_pc(vcpu) = vcpu_read_sys_reg(vcpu, ELR_EL1);
+		apple_fast_install(vcpu, f, el);
+		break;
+	default:
+		return 0;
+	}
+	f->handled++;
+	return 1;
+}
+
 /**
  * kvm_handle_sys_reg -- handles a system instruction or mrs/msr instruction
