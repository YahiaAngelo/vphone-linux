+#define APPLE_READ_IMM(vreg)	(0x8000 | ((vreg) << 6) | 0x20)
+#define APPLE_TTBR_BADDR	0x0000fffffffffffeULL
+
+/*
+ * An EL0 write of SPRR_UPERM_BR0_EL0 from Xrt, at elr in EL0 with spsr (struct
+ * kvm_arm_apple_fast's perm_*). 0 for userspace.
+ */
+static int apple_fast_el0_perm_write(struct kvm_vcpu *vcpu, struct kvm_arm_apple_fast *f, u8 rt,
+				     u64 spsr, u64 elr)
+{
+	u64 x = rt == 31 ? 0 : vcpu_get_reg(vcpu, rt);
+	u64 cur, ttbr0, ttbr1, v, le;
+	u32 i, n;
+
+	if (f->perm_ok != 1 || (f->disable & BIT(13)) || f->resume_valid || f->guarded != 0 ||
+	    !apple_get_read(f, APPLE_READ_IMM(5), &cur))
+		return 0;
+	v = (cur & ~f->perm_mask) | (x & f->perm_mask);
+	if (v == cur) {
+		*vcpu_cpsr(vcpu) = spsr & f->pstate_mask;
+		*vcpu_pc(vcpu) = elr + 4;
+		apple_fast_install(vcpu, f, 0);
+		f->handled++;
+		return 1;
+	}
+	if (!(f->ws_ok & 3) || !apple_get_read(f, APPLE_READ_IMM(17), &ttbr0) ||
+	    !apple_get_read(f, APPLE_READ_IMM(18), &ttbr1) ||
+	    (ttbr1 & APPLE_TTBR_BADDR) != (f->perm_ttbr1 & APPLE_TTBR_BADDR))
+		return 0;
+	n = min_t(u32, READ_ONCE(f->nperm), ARRAY_SIZE(f->perm_val));
+	for (i = 0; i < n; i++) {
+		int w;
+
+		if (f->perm_val[i] != v || f->perm_ttbr0[i] != (ttbr0 & APPLE_TTBR_BADDR))
+			continue;
+		if (f->perm_mirror) {
+			le = cpu_to_le64(v);
+			if (kvm_write_guest(vcpu->kvm, f->perm_mirror, &le, sizeof(le)))
+				return 0;
+		}
+		for (w = 0; w < 2; w++) {
+			f->ttbr[w][0] = (ttbr0 & ~(APPLE_TTBR_BADDR | 1)) | f->perm_shadow[i][w][0];
+			f->ttbr[w][1] = (ttbr1 & ~(APPLE_TTBR_BADDR | 1)) | f->perm_shadow[i][w][1];
+		}
+		/* The TTBR0 tables published were made for the old permissions. */
+		f->ttbr0_ok = 0;
+		apple_set_read(f, APPLE_READ_IMM(5), v);
+		f->perm_guest = v;
+		f->perm_writes++;
+		apple_enter_world(vcpu, f, 0, spsr & f->pstate_mask, elr + 4);
+		f->handled++;
+		return 1;
+	}
+	return 0;
+}
