#!/usr/bin/env bash
# Prefer the Release build, with a fallback for an existing Debug product:
#
#   linux-create/vphone-cli fw prepare ...
#   sudo linux-create/vphone-cli cfw install ...
set -Eeuo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
products=$here/.build/out/out/Products
machine=$(uname -m)
bin=$products/Release-linux-$machine/vphone-cli
if [ ! -x "$bin" ] && [ -x "$products/Debug-linux-$machine/vphone-cli" ]; then
  bin=$products/Debug-linux-$machine/vphone-cli
  echo "WARN: Release vphone-cli is not built. This invocation is using the existing Debug product: $bin" >&2
fi
if [ ! -x "$bin" ]; then
  echo "vphone-cli is not built: $products" >&2
  echo "From the vphone-linux checkout, run: ./linux-create/build.sh" >&2
  exit 127
fi
exec "$bin" "$@"
