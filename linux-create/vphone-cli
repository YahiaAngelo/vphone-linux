#!/usr/bin/env bash
# Run the Release build of vphone-cli without remembering its build path:
#
#   linux-create/vphone-cli fw prepare ...
#   sudo linux-create/vphone-cli cfw install ...
set -Eeuo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
bin=$here/.build/out/out/Products/Release-linux-$(uname -m)/vphone-cli
if [ ! -x "$bin" ]; then
  echo "Release vphone-cli is not built: $bin" >&2
  echo "From the Limulator checkout, run: uv run limulator bootstrap cli" >&2
  exit 127
fi
exec "$bin" "$@"
