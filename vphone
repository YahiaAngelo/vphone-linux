#!/usr/bin/env bash
# vphone - a small command-line launcher for vphone-linux VMs.
#
# One command boots an existing VM in its window and unlocks iOS:
#
#   ./vphone                     # the only VM, or the one in $VPHONE_VM
#   ./vphone start NAME          # a specific VM (name or path)
#   ./vphone start --fast NAME   # return as soon as QEMU is up, skip the unlock wait
#   ./vphone stop [NAME]
#   ./vphone status [NAME]
#   ./vphone list
#   ./vphone logs [NAME]
#   ./vphone install         # symlink into ~/.local/bin, so 'vphone' works anywhere
#
# This is a thin wrapper around setup/start-vm.sh; its environment knobs (MEM,
# SMP, TOOLBAR, ...) still apply. The vsock CID comes from the VM's "cid" file.
# It only adds VM discovery and a short command vocabulary. Nothing here
# creates or modifies a VM.
set -Eeuo pipefail

# Resolve symlinks so a link in ~/.local/bin still finds this checkout's setup scripts.
SOURCE=${BASH_SOURCE[0]}
while [ -L "$SOURCE" ]; do
  SOURCE_DIR=$(cd -P "$(dirname "$SOURCE")" && pwd)
  SOURCE=$(readlink "$SOURCE")
  [[ $SOURCE == /* ]] || SOURCE=$SOURCE_DIR/$SOURCE
done
ROOT=$(cd -P "$(dirname "$SOURCE")" && pwd)
# Test hook only: setup/test/vphone-cli.sh points this at a stub launcher.
START=${VPHONE_START:-$ROOT/setup/start-vm.sh}
DEVICES=${VSETUP_DEVICES:-$HOME/vphone-setup-work/devices}

log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mWARN\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mERROR\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage: vphone [COMMAND] [OPTIONS] [VM]

Commands:
  start [VM]          Boot a VM in its window and unlock iOS (default command)
  stop [VM]           Shut the guest down through vphoned
  status [VM]         Show whether a VM is running
  list                List VMs and their state
  logs [VM]           Follow the VM's serial log (ctrl-C to stop)
  install             Link this CLI into ~/.local/bin (or $VPHONE_BIN_DIR)
  help                Show this help

Options for start:
  --fast              Return as soon as QEMU is up; do not wait to unlock
  -h, --help          Show this help

VM selection:
  Omit VM when there is only one, or set VPHONE_VM to its name/path.
  With several VMs, pass a name: there is no interactive menu.
  Names are directories under $VSETUP_DEVICES (default ~/vphone-setup-work/devices).
  Unlike 'start-vm.sh --list', any directory with a Disk.img is listed, including
  VMs that were booted directly with run-vphone.sh and have no "booted" marker.
  Environment knobs such as MEM=6G SMP=6 vphone and TOOLBAR=0 vphone pass through.
  The vsock CID comes from the VM's "cid" file; set it at creation time with
  CID=4 ./setup/create-vm.sh.

Examples:
  ./vphone
  ./vphone --fast                 # same as: ./vphone start --fast
  ./vphone start --fast my-vm
  ./vphone list
  ./vphone logs
  ./vphone install            # use 'vphone' from any directory
EOF
}

vm_dirs() {
  local d
  for d in "$DEVICES"/*/; do
    [ -d "$d" ] || continue
    [ -e "$d/Disk.img" ] || continue
    printf '%s\n' "${d%/}"
  done
}

resolve_vm() {
  local arg=${1:-}
  if [ -n "$arg" ]; then
    if [ -d "$arg" ] && [ -e "$arg/Disk.img" ]; then
      printf '%s\n' "$(cd "$arg" && pwd)"
      return 0
    fi
    if [ -e "$DEVICES/$arg/Disk.img" ]; then
      printf '%s\n' "$DEVICES/$arg"
      return 0
    fi
    die "no VM at '$arg' (see 'vphone list')"
  fi

  if [ -n "${VPHONE_VM:-}" ]; then
    if [ -d "$VPHONE_VM" ] && [ -e "$VPHONE_VM/Disk.img" ]; then
      printf '%s\n' "$(cd "$VPHONE_VM" && pwd)"
      return 0
    fi
    if [ -e "$DEVICES/$VPHONE_VM/Disk.img" ]; then
      printf '%s\n' "$DEVICES/$VPHONE_VM"
      return 0
    fi
    die "VPHONE_VM points to no VM: $VPHONE_VM (see 'vphone list')"
  fi

  local found=()
  mapfile -t found < <(vm_dirs)
  case ${#found[@]} in
    0) die "no VMs in $DEVICES yet: make one with ./setup/create-vm.sh" ;;
    1) printf '%s\n' "${found[0]}" ;;
    *) die "several VMs in $DEVICES: pass a name or set VPHONE_VM (see 'vphone list')" ;;
  esac
}

qemu_pid() {
  local vm=$1 p
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    tr '\0' '\n' < "/proc/$p/cmdline" 2>/dev/null |
      grep -Fq "file=$vm/Disk.img" && { printf '%s\n' "$p"; return 0; }
  done < <(pgrep -x qemu-system-aar 2>/dev/null || true)
  return 1
}

cid_of() { cat "$1/cid" 2>/dev/null || printf '3\n'; }

cmd_start() {
  local fast=0 name=''
  while [ $# -gt 0 ]; do
    case $1 in
      --fast) fast=1 ;;
      -h|--help) usage; exit 0 ;;
      -*) die "unknown option $1 (see 'vphone help')" ;;
      *) [ -z "$name" ] || die "too many VM arguments (see 'vphone help')"; name=$1 ;;
    esac
    shift
  done

  local vm args=()
  vm=$(resolve_vm "$name")
  [ -x "$START" ] || die "missing $START: run ./setup/setup.sh first"
  [ "$fast" = 0 ] || args+=(--no-unlock)
  log "booting $(basename "$vm")"
  exec "$START" "${args[@]}" "$vm"
}

cmd_stop() {
  [ $# -le 1 ] || die "usage: vphone stop [VM]"
  local vm
  vm=$(resolve_vm "${1:-}")
  exec "$START" --stop "$vm"
}

cmd_status() {
  [ $# -le 1 ] || die "usage: vphone status [VM]"
  local vm p
  vm=$(resolve_vm "${1:-}")
  if p=$(qemu_pid "$vm"); then
    printf '%-32s running (QEMU pid %s), vsock CID %s\n' "$(basename "$vm")" "$p" "$(cid_of "$vm")"
  else
    printf '%-32s stopped, vsock CID %s\n' "$(basename "$vm")" "$(cid_of "$vm")"
  fi
}

cmd_list() {
  [ $# -eq 0 ] || die "usage: vphone list"
  local d p
  while IFS= read -r d; do
    if p=$(qemu_pid "$d"); then
      printf '%-32s running (QEMU pid %s), vsock CID %s\n' "$(basename "$d")" "$p" "$(cid_of "$d")"
    else
      printf '%-32s stopped, vsock CID %s\n' "$(basename "$d")" "$(cid_of "$d")"
    fi
  done < <(vm_dirs)
}

cmd_logs() {
  [ $# -le 1 ] || die "usage: vphone logs [VM]"
  local vm
  vm=$(resolve_vm "${1:-}")
  [ -e "$vm/serial.log" ] || die "no serial.log at $vm; start the VM first"
  exec tail -f "$vm/serial.log"
}

cmd_install() {
  [ $# -eq 0 ] || die "usage: vphone install"
  local bin_dir=${VPHONE_BIN_DIR:-$HOME/.local/bin} target
  mkdir -p "$bin_dir"
  target=$bin_dir/vphone
  if [ -e "$target" ] && [ ! -L "$target" ]; then
    die "$target exists and is not a symlink; remove it first"
  fi
  ln -sfn "$ROOT/vphone" "$target"
  log "linked $target -> $ROOT/vphone"
  case ":$PATH:" in
    *":$bin_dir:"*) ;;
    *) warn "$bin_dir is not on PATH; add it to use 'vphone' from any directory" ;;
  esac
}

case ${1:-} in
  ''|start|boot) shift || true; cmd_start "$@" ;;
  --fast)        cmd_start "$@" ;;  # cmd_start sees the flag; no shift
  stop)          shift; cmd_stop "$@" ;;
  status|ps)     shift; cmd_status "$@" ;;
  list|ls)       shift; cmd_list "$@" ;;
  logs|log)      shift; cmd_logs "$@" ;;
  install)       shift; cmd_install "$@" ;;
  help|-h|--help) usage ;;
  *)             die "unknown command '$1' (see 'vphone help')" ;;
esac
